#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#define DEFAULT  0
#define SYM      1
#define NUM      2
#define NAV      3
#define OUTER    4

/ {
    keymap {
        compatible = "zmk,keymap";

        // Default layer
        // |-----------------------------------------------------------|
        // |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |
        // |-----------------------------------------------------------|
        // |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |     L     |
        // |-----------------------------------------------------------|
        // |  Z     |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |   .    |
        // |-----------------------------------------------------------|
        //        | LSFT | NUM |  LGUI  | LALT | SYM | BSPC |
        //        |-------------------------------------------|
        default_layer {
            bindings = <
    &kp Q      &kp W       &kp E         &kp R           &kp T      &kp Y     &kp U   &kp I     &kp O     &kp P
    &kp A      &kp S       &kp D         &lt NAV F        &lt OUTER G &kp H     &kp J   &kp K     &kp L
    &kp Z      &kp X       &kp C         &kp V           &kp B      &kp N     &kp M   &kp COMMA &kp DOT
    &kp LSHIFT &lt NUM SPACE &kp LGUI      &kp LALT        &lt SYM ENTER &kp BSPC
            >;
        };

        // Symbol layer
        // |------------------------------------------------------------------|
        // |  !  |  @  |  #  |  $  |  %  |  ^  |  &  |  |  |  <  |  >  |
        // |------------------------------------------------------------------|
        // |  (  |  )  |  {  |  }  |  [  |  ]  |  :  |  ;  |  '  |
        // |------------------------------------------------------------------|
        // |  _  |  +  |  -  |  =  |  *  |  /  |  \  |  `  |  ~  |
        // |------------------------------------------------------------------|
        //        | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
        //        |-------------------------------------------|
        sym_layer {
            bindings = <
    &kp EXCL   &kp AT     &kp HASH    &kp DLLR   &kp PRCNT &kp CARET &kp AMPS  &kp PIPE   &kp LT    &kp GT
    &kp LPAR   &kp RPAR   &kp LBRC    &kp RBRC   &kp LBKT  &kp RBKT  &kp COLON &kp SEMI   &kp SQT
    &kp UNDER  &kp KP_PLUS &kp KP_MINUS &kp EQUAL  &kp KP_MULTIPLY &kp FSLH  &kp BSLH  &kp GRAVE  &kp TILDE
    &trans     &trans     &trans       &trans     &trans    &trans
            >;
        };

        // Number layer
        // |-----------------------------------------------------------------|
        // | TRNS | TRNS | TRNS | TRNS | TRNS | PIPE |  =  |  [  |  ]  |  \  |
        // |-----------------------------------------------------------------|
        // |  1   |  2   |  3   |  4   |  5   |  6  |  7  |  8  |  9  |
        // |-----------------------------------------------------------------|
        // | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |  0  |
        // |-----------------------------------------------------------------|
        //        | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
        //        |-------------------------------------------|
        num_layer {
            bindings = <
    &trans  &trans  &trans  &trans  &trans  &kp PIPE &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6   &kp N7   &kp N8   &kp N9
    &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans   &kp N0
    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Navigation / system layer
        // |-----------------------------------------------------------------|
        // | TRNS | TRNS | TRNS | TRNS | TRNS | RST  | TRNS | TRNS |  UP | TRNS |
        // |-----------------------------------------------------------------|
        // | TRNS | TRNS | TRNS | TRNS | BTL  | TRNS | LEFT | DOWN | RIGHT |
        // |-----------------------------------------------------------------|
        // | BCLR | BT0  | BT1  | BT2  | SLP  | TRNS | TRNS | TRNS | TRNS |
        // |-----------------------------------------------------------------|
        //        | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
        //        |-------------------------------------------|
        nav_layer {
            bindings = <
    &trans      &trans       &trans       &trans       &trans &reset      &trans     &trans    &kp UP   &trans
    &trans      &trans       &trans       &trans       &bootloader &trans  &kp LEFT   &kp DOWN  &kp RIGHT
    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp C_SLEEP &trans  &trans     &trans    &trans
    &trans      &trans       &trans       &trans       &trans     &trans
            >;
        };

        // Outer keys layer (hold G)
        // |-----------------------------------------------------------------|
        // | TAB  | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | BSPC |
        // |-----------------------------------------------------------------|
        // | ESC  | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | ENTER |
        // |-----------------------------------------------------------------|
        // | LSHFT| TRNS | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |  DEL  |
        // |-----------------------------------------------------------------|
        //        | TRNS | TRNS | TRNS | TRNS | TRNS | TRNS |
        //        |-------------------------------------------|
        outer_layer {
            bindings = <
    &kp TAB    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp BSPC
    &kp ESC    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp ENTER
    &kp LSHIFT &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL
    &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
